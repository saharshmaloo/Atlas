DATABASE_URL=postgresql+psycopg://atlas:atlas@127.0.0.1:5432/atlas
TEST_DATABASE_URL=postgresql+psycopg://atlas:atlas@127.0.0.1:5433/atlas_test
# Set these to enable model-backed answers. Choose a model supporting Structured Outputs.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional semantic judgments; without this, support judgments remain uncertain.
ATLAS_VERIFIER_MODEL=
# Optional vector retrieval. Choose a model supporting the dimensions parameter.
ATLAS_EMBEDDING_MODEL=
ATLAS_EMBEDDING_DIMENSIONS=1536
ATLAS_EMBEDDING_VERSION=1
# Optional reranker: lexical-v1. Requests must also opt in with rerank=true.
ATLAS_RERANKER=
